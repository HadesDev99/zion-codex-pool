# Point Codex CLI / IDE at a local Zion Codex Pool instance.
# User-level only (~/.codex/config.toml) — project-local layers cannot set model_provider.
# The pooler is fixed to local loopback and does not require a client key.
# The VS Code / Cursor extension replaces this whole managed block on "Wire Codex to Pool".

# >>> zion-pool managed
model_provider = "zion-pool"

[model_providers.zion-pool]
name = "OpenAI"
base_url = "http://127.0.0.1:4000/backend-api/codex"
wire_api = "responses"
supports_websockets = true
requires_openai_auth = true
# <<< zion-pool managed
