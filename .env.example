# Listen address — keep 127.0.0.1 for solo local use
PORT=4000
HOST=127.0.0.1

# Optional. Leave unset for open local access (recommended on 127.0.0.1).
# Set only if you bind beyond loopback.
# POOL_API_KEY=

# Where accounts + state live (default: ~/.zion-codex-pool)
# DATA_DIR=/Users/you/.zion-codex-pool

# Skip accounts at or above this quota % when picking
QUOTA_SKIP_THRESHOLD=95

# How often to refresh quota for all accounts (ms)
QUOTA_POLL_MS=120000

# Upstream Codex backend
UPSTREAM_BASE=https://chatgpt.com/backend-api/codex
